# TrustLedger Environment Variables
# Copy this file to .env and fill in your values

# ------- Backend -------
PORT=4000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/trustledger

# JWT
JWT_SECRET=trustledger-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Blockchain (Hardhat local node)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Contract Addresses (populated after deploy)
CONTRACT_ENTRY_POINT=
CONTRACT_ACCOUNT_FACTORY=
CONTRACT_PAYMASTER=
CONTRACT_PROPERTY_REGISTRY=
CONTRACT_ESCROW=

# Relayer / Bundler Wallet (Hardhat account #5 private key, DO NOT use in prod)
RELAYER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# Sponsor Wallet (Hardhat account #6 — funds the paymaster deposit)
SPONSOR_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25
